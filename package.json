{
  "name": "mcaas-contpaqi",
  "version": "0.1.0",
  "private": true,
  "description": "Servicio Windows de integración MySQL/CONTPAQi hacia una API HTTP(S).",
  "main": "dist/main.js",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/verify-project.mjs",
    "start": "node --env-file=.env dist/main.js",
    "start:prod": "node --env-file=.env dist/main.js",
    "start:dev": "node --env-file=.env ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "config:check": "node --env-file=.env dist/commands/check-config.js",
    "connections:test": "node --env-file=.env dist/commands/test-connections.js",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "mysql2": "3.24.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@types/node": "24.13.3",
    "typescript": "6.0.3"
  }
}
