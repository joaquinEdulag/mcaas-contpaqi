# ============================================================
# MCAAS - CONTPAQi Nóminas -> ERP EDULAG
# Copia como .env y completa SOLO los valores pendientes.
# NUNCA subas .env a Git.
# ============================================================

# ------------------------------------------------------------
# APLICACION
# ------------------------------------------------------------
APP_ENV=development
APP_NAME=MCAAS CONTPAQi Bridge
INSTANCE_ID=CONTPAQI-NOMINAS-EDULAG-01
SOURCE_SYSTEM=CONTPAQI

# ------------------------------------------------------------
# ORIGEN: SQL SERVER / CONTPAQi
# ------------------------------------------------------------
# 127.0.0.1 funciona si este puente corre en la MISMA PC del SQL Server.
SQLSERVER_HOST=127.0.0.1

# Para CONTPAQi normalmente será COMPAC.
SQLSERVER_INSTANCE=COMPAC

# Déjalo vacío cuando uses una instancia con puerto dinámico.
# Si conoces un puerto fijo, usa SQLSERVER_PORT y deja SQLSERVER_INSTANCE vacío.
SQLSERVER_PORT=

# OJO: aquí va el NOMBRE DE LA BASE que contiene dbo.nom10001.
# NO pongas dbo.nom10001 y NO pongas edulag_pruebas.
SQLSERVER_DATABASE=

SQLSERVER_USER=CONSULTAS
SQLSERVER_PASSWORD=

SQLSERVER_POOL_MAX=5
SQLSERVER_POOL_MIN=0
SQLSERVER_POOL_IDLE_TIMEOUT_MS=30000
SQLSERVER_CONNECT_TIMEOUT_MS=15000
SQLSERVER_REQUEST_TIMEOUT_MS=30000

# Para la primera prueba en la red local.
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# ------------------------------------------------------------
# DESTINO: RECEIVER HTTP/HTTPS
# ------------------------------------------------------------
# Ejemplo local: http://127.0.0.1:3000
# Ejemplo real:  https://receiver-pruebas.tudominio.com
DESTINATION_BASE_URL=http://127.0.0.1:3000
DESTINATION_HEALTH_PATH=/health

# bearer | api-key | none
DESTINATION_AUTH_MODE=none
DESTINATION_API_TOKEN=
DESTINATION_API_KEY=
DESTINATION_API_KEY_HEADER=x-api-key

# true SOLO porque el ejemplo local usa HTTP.
# En HTTPS cambia a false.
DESTINATION_ALLOW_INSECURE_HTTP=true
HTTP_TIMEOUT_MS=15000
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_BASE_DELAY_MS=1000

# ------------------------------------------------------------
# SINCRONIZACION
# ------------------------------------------------------------
# Primero false. Actívalo solo después de ejecutar connections:test.
SYNC_ENABLED=false
SYNC_INTERVAL_MS=30000
SYNC_BATCH_SIZE=5
SYNC_MAX_BATCHES_PER_CYCLE=1
SYNC_PAUSE_BETWEEN_BATCHES_MS=250
SYNC_MODELS=employees

# ------------------------------------------------------------
# ARCHIVOS LOCALES
# ------------------------------------------------------------
MODEL_CONFIG_PATH=./config/sync-models.json
CHECKPOINT_PATH=./data/checkpoints.json

# ------------------------------------------------------------
# LOGS / DIAGNOSTICO
# ------------------------------------------------------------
# Se guardan relativos a la carpeta desde donde se ejecuta MCAAS.
LOG_DIRECTORY=./logs

# false = registra acciones, IDs, cursores, cantidades y respuestas del receiver.
# true  = ademas imprime el contenido completo de cada registro; puede contener datos personales.
LOG_RECORD_PAYLOADS=false
