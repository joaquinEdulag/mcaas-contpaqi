# ============================================================
# MCAAS - CONTPAQi Bridge
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas .env a Git.
# ============================================================

# ------------------------------------------------------------
# APLICACION
# ------------------------------------------------------------
APP_ENV=production
APP_NAME=MCAAS CONTPAQi Bridge
INSTANCE_ID=
SOURCE_SYSTEM=CONTPAQI

# ------------------------------------------------------------
# MYSQL / FUENTE CONTPAQi
# La cuenta debe tener permisos SOLO DE LECTURA.
# ------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=5
MYSQL_CONNECT_TIMEOUT_MS=10000

# TLS de MySQL. En LAN puede empezar en false si la instalación
# actual no soporta TLS; para producción remota se recomienda true.
MYSQL_SSL=false
MYSQL_SSL_CA_PATH=
MYSQL_SSL_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------
# API DESTINO
# ------------------------------------------------------------
DESTINATION_BASE_URL=https://127.0.0.1:8443
DESTINATION_HEALTH_PATH=/health

# bearer | api-key | none
DESTINATION_AUTH_MODE=bearer
DESTINATION_API_TOKEN=
DESTINATION_API_KEY=
DESTINATION_API_KEY_HEADER=x-api-key

# HTTP sin TLS está bloqueado por defecto.
# Cambiar a true SOLO para pruebas o una LAN controlada.
DESTINATION_ALLOW_INSECURE_HTTP=false
HTTP_TIMEOUT_MS=15000
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_BASE_DELAY_MS=1000

# ------------------------------------------------------------
# SINCRONIZACION
# ------------------------------------------------------------
# false = el servicio corre pero NO extrae ni envía datos.
# Déjalo en false hasta configurar config/sync-models.json y queries/.
SYNC_ENABLED=false
SYNC_INTERVAL_MS=30000
SYNC_BATCH_SIZE=100
SYNC_MAX_BATCHES_PER_CYCLE=10
SYNC_PAUSE_BETWEEN_BATCHES_MS=250

# Lista opcional separada por comas. Vacío = todos los modelos
# marcados enabled=true en config/sync-models.json.
SYNC_MODELS=

# ------------------------------------------------------------
# ARCHIVOS LOCALES
# ------------------------------------------------------------
MODEL_CONFIG_PATH=./config/sync-models.json
CHECKPOINT_PATH=./data/checkpoints.json
